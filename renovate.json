{
  "regexManagers": [
    {
      "fileMatch": ["\\.yml\\.j2$"],
      "matchStrings": ["image:\\s+(?<depName>[^:]+):(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ubuntu"],
      "allowedVersions": "/^\\d+\\.04$/"
    }
  ]
}
