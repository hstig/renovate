# roles/docker_payload_storage/templates/docker-compose.yml.j2
services:
  cloudflare-tunnel:
    image: cloudflare/cloudflared:2026.10.0
    container_name: cloudflared-{{ inventory_hostname }}
    restart: unless-stopped
    command: tunnel run
    environment:
      - TUNNEL_TOKEN=your_test_token_here

  sample-app:
    image: ubuntu:23.04
    container_name: sample-nginx-{{ inventory_hostname }}
    restart: unless-stopped
    ports:
      - "8080:80"
    volumes:
      - {{ docker_payload_path }}/html:/usr/share/nginx/html
